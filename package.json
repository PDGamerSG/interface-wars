{
  "name": "interface-wars",
  "version": "1.0.0",
  "private": true,
  "description": "CLI vs MCP vs Skill: Flagsmith Experimentation decides how AI agents should operate Flagsmith",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test test/",
    "typecheck": "tsc -p .",
    "lab:up": "docker compose -p interface-wars -f infra/compose.yml up -d && node src/lab/bootstrap.ts",
    "lab:down": "docker compose -p interface-wars -f infra/compose.yml down -v",
    "lab:reset": "./scripts/lab-reset.sh",
    "cli:image": "docker build -t interface-wars-cli:2.0.0 -f infra/cli.Dockerfile infra",
    "selftest": "node src/jobs/selftest.ts",
    "experiment:start": "node src/cli.ts experiment:start",
    "experiment:status": "node src/cli.ts experiment:status",
    "trials": "node src/run.ts",
    "readout": "node src/cli.ts readout",
    "ship": "node src/cli.ts ship",
    "which": "node src/cli.ts which",
    "plan": "node src/cli.ts plan",
    "demo": "node scripts/demo.ts",
    "release": "node skills/flagsmith-release-gate/scripts/release.ts",
    "evidence": "node scripts/evidence.ts",
    "tokens": "node scripts/count-tokens.ts",
    "export:web": "node scripts/export-web-data.ts",
    "release:smoke": "npm exec --yes --package=@flagsmith/cli@2.0.0 -- node scripts/release-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@flagsmith/nodejs": "^9.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
